# Port dan host server Express
PORT=3007
HOST=0.0.0.0

# Aktifkan jika aplikasi berada di belakang reverse proxy TLS (Nginx/Caddy/Cloudflare Tunnel)
TRUST_PROXY=false

# Paksa cookie sesi Secure (true = hanya HTTPS, false = izinkan HTTP LAN, kosong = otomatis ikut HTTPS/X-Forwarded-Proto)
# COOKIE_SECURE=false

# Daftar origin tambahan yang diizinkan untuk CORS (pisahkan dengan koma), kosong = same-origin saja
# ALLOWED_ORIGINS=https://pinglo.example.com

# Kunci enkripsi AES-256-GCM untuk kredensial SNMP di SQLite (opsional; otomatis dibuat di data/.master.key jika kosong)
# PINGLO_ENCRYPTION_KEY=

# Override lokasi folder database SQLite & .master.key (opsional)
# PINGLO_DATA_DIR=./data

# Password awal saat database baru pertama kali dibuat (minimal 8 karakter; opsional)
# PINGLO_BOOTSTRAP_SUPERADMIN_PASSWORD=
# PINGLO_BOOTSTRAP_ADMIN_PASSWORD=

# Izinkan SNMP ke 127.0.0.1 / localhost hanya untuk simulasi lab lokal (jangan aktifkan di server produksi)
PINGLO_ALLOW_LOOPBACK_SNMP=false
